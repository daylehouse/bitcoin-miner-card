{
  "name": "bitcoin-miner-card",
  "version": "0.2.11",
  "description": "Custom Home Assistant Lovelace card for monitoring Bitcoin miners.",
  "type": "module",
  "main": "dist/bitcoin-miner-card.js",
  "files": [
    "dist",
    "hacs.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c && npm run copy-assets",
    "copy-assets": "cp -f base-layer.png dist/base-layer.png",
    "preview": "npm run build && npx --yes serve -l 4173 .",
    "watch": "rollup -c -w",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "bitcoin",
    "miner"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-url": "^8.0.2",
    "rollup": "^4.40.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "tslib": "^2.8.1"
  }
}
